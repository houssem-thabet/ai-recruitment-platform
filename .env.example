# Database connection string (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/talentai?schema=public"

# Cryptographic session signing secret (generate via: openssl rand -hex 32)
JWT_SECRET="replace-with-secure-32-byte-hex-secret-in-production"

# Public branding configuration
NEXT_PUBLIC_APP_NAME="TalentAI"
NEXT_PUBLIC_APP_SLOGAN="Find the right talent. Hire with intelligence."

# Private CV storage path (outside web-accessible public/ folder)
CV_STORAGE_DIR="./storage/cvs"
MAX_CV_FILE_SIZE_BYTES="5242880"

# =============================================================================
# AI Engine Configuration (Multi-Provider + Automatic Deterministic Fallback)
# Leave all API keys empty to run in transparent Deterministic NLP & IDF Semantic Mode.
# =============================================================================
AI_PROVIDER="" # Optional override: "openai" | "anthropic" | "gemini"

# Option 1: OpenAI or OpenAI-compatible provider (Chat + Dense Embeddings)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Option 2: Anthropic Claude (Structured JSON Messages API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Option 3: Google Gemini (Structured JSON + Batch Embeddings)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
